<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<title>你愿意成为我的小狗吗 🐶</title>
<style>
  :root{
    --pink:#FF7BA9;
    --pink-deep:#F06292;
    --cream:#F4C78E;
    --ear:#E3AC66;
    --muzzle:#FBE3C0;
    --ink:#4A3426;
    --card:#ffffff;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{
    -webkit-tap-highlight-color:transparent;
    -webkit-text-size-adjust:100%;
  }
  body{
    font-family:"PingFang SC","Microsoft YaHei",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    min-height:100vh;
    min-height:100dvh;
    background:linear-gradient(160deg,#FFE3EC 0%,#FFF1E8 55%,#FFEAF3 100%);
    color:var(--ink);
    overflow-x:hidden;
    overscroll-behavior:none;
    user-select:none;
    -webkit-user-select:none;
    touch-action:manipulation;
  }
  .scene{
    min-height:100vh;
    min-height:100dvh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:12px;
    text-align:center;
    padding:calc(env(safe-area-inset-top) + 18px) 20px calc(env(safe-area-inset-bottom) + 20px);
  }
  h1{
    font-size:clamp(1.5rem,6.5vw,2.2rem);
    line-height:1.25;
    font-weight:800;
    letter-spacing:.5px;
    color:var(--pink-deep);
  }
  .subtitle{
    font-size:clamp(.95rem,4vw,1.1rem);
    color:#B08A6A;
  }
  .puppy-box svg{
    display:block;
    width:auto;
    height:min(44vh,330px);
    margin:0 auto;
  }

  /* —— 小狗 SVG 动画 —— */
  .dog{ transform-box:fill-box; }
  .tail{ transform-box:fill-box; transform-origin:18% 84%; animation:wag 1.15s ease-in-out infinite; }
  .ear-l{ transform-box:fill-box; transform-origin:50% 60%; animation:earWig 5s ease-in-out infinite; }
  .ear-r{ transform-box:fill-box; transform-origin:50% 60%; animation:earWig 5s ease-in-out infinite .18s; }
  .eye-normal{ transform-box:fill-box; transform-origin:center; animation:blink 4.5s infinite; }
  .eye-happy{ display:none; }
  .tongue{ display:none; }

  .collar-fly{
    transform-box:fill-box;
    transform-origin:center;
    transition:transform .8s cubic-bezier(.34,1.56,.64,1);
    transform:translate(-120px,-72px) rotate(-18deg) scale(1.12);
  }
  .collar-float{ transform-box:fill-box; animation:floatY 2.6s ease-in-out infinite; }
  .bell{ transform-box:fill-box; transform-origin:50% 0%; }

  @keyframes wag{ 0%,100%{ transform:rotate(9deg);} 50%{ transform:rotate(-9deg);} }
  @keyframes earWig{ 0%,88%,100%{ transform:rotate(0deg);} 92%{ transform:rotate(7deg);} 96%{ transform:rotate(-3deg);} }
  @keyframes blink{ 0%,91%,100%{ transform:scaleY(1);} 94%{ transform:scaleY(.08);} 97%{ transform:scaleY(1);} }
  @keyframes floatY{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-10px);} }
  @keyframes happyBounce{ 0%,100%{ transform:translateY(0);} 30%{ transform:translateY(-14px);} 60%{ transform:translateY(0);} 80%{ transform:translateY(-6px);} }
  @keyframes bellWiggle{ 0%,100%{ transform:rotate(0deg);} 25%{ transform:rotate(16deg);} 75%{ transform:rotate(-16deg);} }

  /* 愿意之后的状态 */
  .scene.happy .tail{ animation-duration:.34s; }
  .scene.happy .eye-normal{ display:none; }
  .scene.happy .eye-happy{ display:block; }
  .scene.happy .tongue{ display:block; }
  .scene.happy .collar-fly{ transform:translate(0,0) rotate(0deg) scale(1); }
  .scene.happy .collar-float{ animation:none; }
  .scene.happy .bell{ animation:bellWiggle .5s ease-in-out .8s 2; }
  .scene.happy .dog{ animation:happyBounce .6s ease-in-out 1.3s 3; }

  /* —— 气泡 —— */
  .bubble{
    max-width:min(88vw,480px);
    background:var(--card);
    border-radius:20px;
    padding:14px 20px;
    font-size:clamp(1rem,4.4vw,1.15rem);
    font-weight:600;
    color:#7A5A40;
    box-shadow:0 8px 24px rgba(240,98,146,.16);
    position:relative;
    transition:transform .2s ease;
  }
  .bubble.shake{ animation:bubbleShake .5s ease; }
  @keyframes bubbleShake{ 0%,100%{ transform:translateX(0);} 20%{ transform:translateX(-6px);} 40%{ transform:translateX(6px);} 60%{ transform:translateX(-4px);} 80%{ transform:translateX(4px);} }

  /* —— 按钮 —— */
  .btn-row{ display:flex; gap:18px; flex-wrap:wrap; justify-content:center; }
  .btn{
    width:clamp(7.2rem,34vw,9rem);
    height:3.5rem;
    border:none;
    border-radius:2rem;
    font-size:1.15rem;
    font-weight:700;
    cursor:pointer;
    letter-spacing:1px;
    box-shadow:0 6px 16px rgba(0,0,0,.12);
    outline:none;
    -webkit-user-select:none;
    user-select:none;
    touch-action:manipulation;
    transition:transform .2s ease, box-shadow .2s ease, opacity .3s ease;
  }
  .btn:active{ transform:scale(.95); }
  .btn-yes{
    background:linear-gradient(135deg,var(--pink),var(--pink-deep));
    color:#fff;
    animation:pulse 1.6s ease-in-out infinite;
  }
  .btn-yes:active{ transform:scale(.92); }
  .btn-no{ background:#F0E9F5; color:#9B7FA6; }
  @keyframes pulse{ 0%,100%{ box-shadow:0 6px 16px rgba(240,98,146,.35);} 50%{ box-shadow:0 6px 26px rgba(240,98,146,.65);} }

  /* —— 逃跑提示 —— */
  .hint{
    position:fixed;
    left:0; top:0;
    transform:translate(-50%,-100%);
    background:#fff;
    color:var(--pink-deep);
    font-size:.92rem;
    font-weight:700;
    padding:6px 14px;
    border-radius:14px;
    box-shadow:0 6px 16px rgba(240,98,146,.25);
    white-space:nowrap;
    pointer-events:none;
    z-index:40;
    display:none;
  }
  .hint.pop{ display:block; animation:hintPop 1.1s ease forwards; }
  @keyframes hintPop{
    0%{ opacity:0; transform:translate(-50%,-100%) scale(.6);}
    15%{ opacity:1; transform:translate(-50%,-125%) scale(1.05);}
    70%{ opacity:1; transform:translate(-50%,-135%) scale(1);}
    100%{ opacity:0; transform:translate(-50%,-165%) scale(.9);}
  }

  /* —— 爱心粒子 —— */
  .hearts{ position:fixed; inset:0; pointer-events:none; z-index:6; overflow:hidden; }
  .heart{
    position:fixed;
    bottom:-50px;
    animation:rise linear forwards;
    will-change:transform,opacity;
  }
  @keyframes rise{
    0%{ transform:translate(0,0) rotate(0deg) scale(.7); opacity:0; }
    10%{ opacity:1; }
    100%{ transform:translate(var(--sway,0px),calc(-100vh - 90px)) rotate(18deg) scale(1.1); opacity:0; }
  }
</style>
</head>
<body>
<div class="scene" id="scene">
  <h1 id="title">你愿意成为我的小狗吗？</h1>
  <p class="subtitle" id="subtitle">汪～ 请认真回答哦</p>

  <div class="puppy-box">
    <svg viewBox="0 0 300 340" role="img" aria-label="一只可爱的小狗">
      <g class="dog">
        <!-- 地面阴影 -->
        <ellipse cx="150" cy="306" rx="86" ry="11" fill="rgba(120,60,20,.08)"/>

        <!-- 尾巴 -->
        <g class="tail">
          <path d="M206 252 Q244 252 246 224 Q247 198 232 198" fill="none" stroke="#E3AC66" stroke-width="17" stroke-linecap="round"/>
        </g>

        <!-- 身体 -->
        <ellipse cx="150" cy="232" rx="76" ry="58" fill="#F4C78E"/>
        <ellipse cx="150" cy="252" rx="50" ry="40" fill="#FBE3C0"/>

        <!-- 耳朵 -->
        <g class="ear-l">
          <g transform="rotate(16 88 92)"><ellipse cx="88" cy="92" rx="24" ry="44" fill="#E3AC66"/></g>
        </g>
        <g class="ear-r">
          <g transform="rotate(-16 212 92)"><ellipse cx="212" cy="92" rx="24" ry="44" fill="#E3AC66"/></g>
        </g>

        <!-- 头 -->
        <circle cx="150" cy="118" r="70" fill="#F4C78E"/>
        <!-- 口鼻 -->
        <ellipse cx="150" cy="150" rx="42" ry="30" fill="#FBE3C0"/>
        <!-- 腮红 -->
        <circle cx="102" cy="136" r="9" fill="#F79F9F" opacity=".75"/>
        <circle cx="198" cy="136" r="9" fill="#F79F9F" opacity=".75"/>

        <!-- 正常眼睛（会眨眼） -->
        <g class="eye-normal eye-l">
          <circle cx="118" cy="110" r="9" fill="#4A3426"/>
          <circle cx="121" cy="107" r="3" fill="#fff"/>
        </g>
        <g class="eye-normal eye-r">
          <circle cx="182" cy="110" r="9" fill="#4A3426"/>
          <circle cx="185" cy="107" r="3" fill="#fff"/>
        </g>
        <!-- 开心眼睛（^ ^） -->
        <g class="eye-happy">
          <path d="M106 110 Q118 94 130 110" fill="none" stroke="#4A3426" stroke-width="5" stroke-linecap="round"/>
          <path d="M170 110 Q182 94 194 110" fill="none" stroke="#4A3426" stroke-width="5" stroke-linecap="round"/>
        </g>

        <!-- 鼻子 -->
        <ellipse cx="150" cy="138" rx="11" ry="8" fill="#4A3426"/>
        <ellipse cx="147" cy="135.5" rx="3" ry="2" fill="#fff" opacity=".85"/>

        <!-- 嘴巴 + 舌头 -->
        <path d="M137 149 Q150 160 163 149" fill="none" stroke="#4A3426" stroke-width="3.5" stroke-linecap="round"/>
        <g class="tongue">
          <path d="M143 157 Q150 172 157 157 Z" fill="#F27D8C"/>
        </g>

        <!-- 前爪 -->
        <ellipse cx="126" cy="290" rx="17" ry="12" fill="#F4C78E"/>
        <ellipse cx="174" cy="290" rx="17" ry="12" fill="#F4C78E"/>
        <path d="M118 294 q4 2 8 0 M170 294 q4 2 8 0" fill="none" stroke="#E3AC66" stroke-width="2.5" stroke-linecap="round"/>

        <!-- 狗圈（初始悬浮，愿意后飞到脖子上） -->
        <g id="collarFly" class="collar-fly">
          <g class="collar-float">
            <rect x="110" y="176" width="80" height="15" rx="7.5" fill="#EF5B6B"/>
            <rect x="110" y="176" width="80" height="6" rx="3" fill="#FF8FA0" opacity=".6"/>
            <g class="bell">
              <rect x="147" y="188" width="6" height="5" rx="2" fill="#E0A93C"/>
              <circle cx="150" cy="199" r="8" fill="#F7C948"/>
              <circle cx="147" cy="197" r="2" fill="#fff" opacity=".8"/>
              <circle cx="150" cy="203" r="1.8" fill="#C88A2A"/>
            </g>
          </g>
        </g>
      </g>
    </svg>
  </div>

  <div class="bubble" id="bubble">汪！做出你的选择吧～</div>

  <div class="btn-row" id="btnRow">
    <button class="btn btn-yes" id="yesBtn" type="button">愿意 💖</button>
    <button class="btn btn-no" id="noBtn" type="button">不愿意</button>
  </div>
</div>

<div class="hint" id="hint"></div>
<div class="hearts" id="hearts"></div>

<script>
(function(){
  var scene = document.getElementById('scene');
  var title = document.getElementById('title');
  var subtitle = document.getElementById('subtitle');
  var bubble = document.getElementById('bubble');
  var hint = document.getElementById('hint');
  var hearts = document.getElementById('hearts');
  var btnRow = document.getElementById('btnRow');
  var yesBtn = document.getElementById('yesBtn');
  var noBtn = document.getElementById('noBtn');

  var state = 'asking';          // asking | happy
  var dodgeCount = 0;
  var noFixed = false;
  var noX = 0, noY = 0, noScale = 1;
  var lastDodge = 0;

  var sadLines = [
    '你不愿意当我的小狗嘛…',
    '被你拒绝我好难过🥺',
    '真的不要我了吗…',
    '呜…再考虑一下好不好',
    '我等你，我很有耐心的…',
    '别跑啦，我会对你超好的…',
    '汪…你忍心吗…'
  ];
  var hints = ['抓不到我哦~', '嘿嘿，跑掉啦', '再试试嘛~', '我超灵活的！', '诶嘿~'];

  /* ---------- 音效（Web Audio 合成） ---------- */
  var audioCtx = null;
  function ensureAudio(){
    if(!audioCtx){
      var AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return null;
      audioCtx = new AC();
    }
    if(audioCtx.state === 'suspended'){ audioCtx.resume(); }
    return audioCtx;
  }
  function tone(o){
    var ctx = ensureAudio(); if(!ctx) return;
    var t0 = ctx.currentTime + (o.when || 0);
    var osc = ctx.createOscillator();
    var g = ctx.createGain();
    osc.type = o.type || 'sine';
    osc.frequency.setValueAtTime(o.f0, t0);
    if(o.f1 && o.f1 !== o.f0){ osc.frequency.exponentialRampToValueAtTime(o.f1, t0 + o.dur); }
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(o.vol || 0.2, t0 + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + o.dur);
    osc.connect(g); g.connect(ctx.destination);
    osc.start(t0); osc.stop(t0 + o.dur + 0.05);
  }
  function playWoof(){
    tone({f0:280, f1:620, type:'sine', dur:0.18, vol:0.30});
    tone({f0:340, f1:700, type:'sine', dur:0.20, vol:0.26, when:0.12});
  }
  function playSad(){
    tone({f0:420, f1:160, type:'sine', dur:0.35, vol:0.22});
    tone({f0:300, f1:120, type:'triangle', dur:0.40, vol:0.14, when:0.10});
  }
  function playBell(){
    tone({f0:1320, f1:1200, type:'sine', dur:0.5, vol:0.20});
    tone({f0:2640, f1:2400, type:'sine', dur:0.35, vol:0.07});
  }

  // 首次触摸即解锁音频
  document.addEventListener('pointerdown', ensureAudio, {once:true});
  document.addEventListener('touchstart', ensureAudio, {once:true});

  /* ---------- 视口 ---------- */
  function viewport(){
    var vv = window.visualViewport;
    return { w: vv ? vv.width : window.innerWidth, h: vv ? vv.height : window.innerHeight };
  }
  function rectsOverlap(x, y, w, h, r, pad){
    pad = pad || 0;
    return !(x + w + pad < r.left || x - pad > r.right || y + h + pad < r.top || y - pad > r.bottom);
  }
  function applyNoTransform(){
    noBtn.style.transform = 'translate(' + Math.round(noX) + 'px,' + Math.round(noY) + 'px) scale(' + noScale + ')';
  }

  /* ---------- 不愿意：逃跑 ---------- */
  function dodge(){
    if(state !== 'asking') return;
    var now = Date.now();
    if(now - lastDodge < 260) return;
    lastDodge = now;

    dodgeCount++;
    playSad();
    updateSadLine();
    showHint();

    var rect = noBtn.getBoundingClientRect();
    var vp = viewport();

    if(!noFixed){
      noBtn.style.position = 'fixed';
      noBtn.style.left = '0';
      noBtn.style.top = '0';
      noBtn.style.margin = '0';
      noBtn.style.zIndex = '30';
      noX = rect.left;
      noY = rect.top;
      noFixed = true;
      noBtn.style.transition = 'none';
      applyNoTransform();
      void noBtn.offsetWidth; // 强制重排
    }

    noScale = Math.max(0.6, 1 - dodgeCount * 0.08);

    var w = rect.width, h = rect.height;
    var margin = 12;
    var yesRect = yesBtn.getBoundingClientRect();

    var tx, ty, tries = 0;
    do{
      tx = margin + Math.random() * Math.max(1, vp.w - w - margin * 2);
      ty = margin + Math.random() * Math.max(1, vp.h - h - margin * 2);
      tries++;
    }while(rectsOverlap(tx, ty, w, h, yesRect, 40) && tries < 30);

    noX = tx; noY = ty;
    noBtn.style.transition = 'transform .45s cubic-bezier(.34,1.56,.64,1)';
    applyNoTransform();
  }

  function updateSadLine(){
    var line;
    if(dodgeCount <= 4){ line = sadLines[dodgeCount - 1]; }
    else{ line = sadLines[4 + Math.floor(Math.random() * (sadLines.length - 4))]; }
    bubble.textContent = line;
    bubble.classList.remove('shake');
    void bubble.offsetWidth;
    bubble.classList.add('shake');
  }

  function showHint(){
    hint.textContent = hints[Math.floor(Math.random() * hints.length)];
    var r = noBtn.getBoundingClientRect();
    var vp = viewport();
    hint.style.left = Math.min(Math.max(60, r.left + r.width / 2), vp.w - 60) + 'px';
    hint.style.top = Math.max(40, r.top - 10) + 'px';
    hint.classList.remove('pop');
    void hint.offsetWidth;
    hint.classList.add('pop');
  }

  noBtn.addEventListener('pointerdown', dodge);
  noBtn.addEventListener('mouseenter', dodge);
  noBtn.addEventListener('touchstart', function(e){ e.preventDefault(); dodge(); }, {passive:false});
  noBtn.addEventListener('click', dodge);

  // 视口变化时把按钮夹回可见区域
  window.addEventListener('resize', function(){
    if(!noFixed || state !== 'asking') return;
    var vp = viewport();
    var r = noBtn.getBoundingClientRect();
    noX = Math.max(8, Math.min(noX, vp.w - r.width - 8));
    noY = Math.max(8, Math.min(noY, vp.h - r.height - 8));
    applyNoTransform();
  });

  /* ---------- 愿意：戴上狗圈 ---------- */
  function accept(){
    if(state !== 'asking') return;
    state = 'happy';

    playWoof();
    noBtn.style.display = 'none';
    hint.style.display = 'none';
    btnRow.style.display = 'none';

    title.textContent = '欢迎回家，我的小狗 🐶';
    subtitle.textContent = '以后要听主人的话哦';
    bubble.textContent = '汪！最喜欢你啦 ❤️';

    scene.classList.add('happy');
    setTimeout(playBell, 800);
    spawnHearts();
  }

  function spawnHearts(){
    var emojis = ['❤️','💖','💕','🐾','✨','🦴'];
    for(var i = 0; i < 20; i++){
      var s = document.createElement('span');
      s.className = 'heart';
      s.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      s.style.left = (8 + Math.random() * 84) + '%';
      s.style.setProperty('--sway', (Math.random() * 80 - 40) + 'px');
      s.style.fontSize = (16 + Math.random() * 24) + 'px';
      s.style.animationDelay = (Math.random() * 0.6) + 's';
      s.style.animationDuration = (2.2 + Math.random() * 1.6) + 's';
      hearts.appendChild(s);
      (function(el){ setTimeout(function(){ el.remove(); }, 4400); })(s);
    }
  }

  yesBtn.addEventListener('click', accept);
})();
</script>
</body>
</html>
